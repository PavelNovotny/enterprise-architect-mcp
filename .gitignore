# Installed dependencies
node_modules/

# Jest coverage report, regenerated by npm test
coverage/

# Isolated checkouts created by the ce-worktree workflow
.worktrees/

# Machine-local agent skills; the published server does not ship them.
# Deliberately narrower than .github/ so .github/workflows/ stays committable.
.github/skills/

.proxyai/
# Source maps, should tsc ever emit them. The compiled dist/ output is committed
# on purpose, because npx runs the published package straight from it.
*.js.map

# Points EA_QEA_PATH at a private .qea export; see .env.example for the shape.
# The .env.* line catches per-environment files even though the server reads
# only .env — Node's --env-file can still load them.
.env
.env.*
!.env.example

# Written by npm run eval:run on every invocation
eval/results.json

# Written by npm run eval:agent on every invocation
eval/agent-results.json
.agent-runner-mcp-config.json

# Scratch state for one-off eval/agent-campaign.ts runs
.campaign-tmp/
.env
